# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://acquisight:acquisight@localhost:5432/acquisight

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
REACT_APP_API_URL=http://localhost:8000

# ── Financial Data Providers (Enterprise Mode) ────────────────────────────────
# Set INSTITUTIONAL_DEMO_MODE=1 to enable Bloomberg/FactSet/CapIQ reference data for demo tickers (MSFT, AAPL, GOOGL)
INSTITUTIONAL_DEMO_MODE=1

# Enterprise API keys (optional — connect live feeds without code changes)
# BLOOMBERG_API_KEY=
# BLOOMBERG_API_URL=https://api.bloomberg.com/eap/catalogs
# FACTSET_API_KEY=
# CAPITAL_IQ_API_KEY=
# REFINITIV_API_KEY=

# Fallback market data
# FMP_API_KEY=
