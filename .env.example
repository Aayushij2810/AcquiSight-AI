# ──────────────────────────────────────────────
# AcquiSight AI — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=acquisight
POSTGRES_USER=acquisight_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://acquisight_user:change_me_in_production@db:5432/acquisight

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
